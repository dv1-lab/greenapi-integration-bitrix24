generator client {
  provider = "prisma-client-js"
}

generator json {
  provider = "prisma-json-types-generator"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               String     @id
  accessToken      String     @db.Text
  refreshToken     String?    @db.Text
  tokenExpiresAt   DateTime?
  portalDomain     String     @unique
  applicationToken String     @db.Text
  instances        Instance[]
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
}

// Mapping для проксирования outgoingMessageStatus webhook'ов от Green API в
// B24 OpenLines. Adapter сохраняет при первом sendDeliveryConfirmation
// после успешной отправки, читает при поступлении статуса от Green API.
// Раньше было in-memory Map — теряется при рестарте adapter'а, новые
// статусы по «висящим» сообщениям не доходили до B24 (часики не уходили).
model OutgoingMessage {
  idMessage        String    @id @db.VarChar(100)  // Green API idMessage
  b24ChatId        String    @map("b24_chat_id") @db.VarChar(100)
  b24MessageId     String    @map("b24_message_id") @db.VarChar(100)
  externalChatId   String    @map("external_chat_id") @db.VarChar(190)
  line             Int
  connector        String    @db.VarChar(64)
  // Последний обработанный outgoingMessageStatus: sent < delivered < read.
  // Защита от дублей вебхуков Green API: одна и та же status-доставка может
  // прилететь несколько раз (retry на стороне Green API), а мы каждый раз
  // вызывали бы imconnector.send.status.delivery в B24 — лишние API вызовы
  // и риск превысить rate-limit.
  lastStatusSeen   String?   @map("last_status_seen") @db.VarChar(16)
  createdAt        DateTime  @default(now())
  expiresAt        DateTime

  @@map("OutgoingMessage")
  @@index([expiresAt])
}

// Дополнительные OAuth-приложения в том же B24-портале. Один процесс
// adapter'а может управлять несколькими app'ами на одном портале для
// распределения CRM-операций (Customer-360) и операций imconnector/OpenLines
// (Social Connector) по разным OAuth-ключам — лимиты B24 per app, ×2 запас
// + изоляция риска бана. См. customer_360_split_b24 memory.
//
// Существующая модель User соответствует appKind='social' (Social Connector,
// первое приложение). Эта таблица для дополнительных, например customer360.
model OAuthApp {
  id               Int       @id @default(autoincrement())
  portalDomain     String    @db.VarChar(190)
  appKind          String    @db.VarChar(32)  // 'customer360' | (будущее)
  clientId         String    @db.VarChar(100)
  clientSecret     String    @db.Text
  accessToken      String    @db.Text
  refreshToken     String?   @db.Text
  tokenExpiresAt   DateTime?
  applicationToken String?   @db.Text
  scope            String?   @db.VarChar(500)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([portalDomain, appKind])
  @@index([appKind])
}

enum InstanceState {
  notAuthorized
  authorized
  yellowCard
  blocked
  starting
}

model Instance {
  id               BigInt         @id @default(autoincrement())
  idInstance       BigInt         @unique
  apiTokenInstance String
  stateInstance    InstanceState?
  userId           String
  user             User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// [InstanceSettings]
  settings         Json?          @default("{}") @db.Json
  bitrixLine       Int?           @db.UnsignedMediumInt
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@unique([userId, bitrixLine])
}

// Кеш phone → chatId для MAX-инстансов. В MAX чаты идентифицируются
// внутренним chatId, не телефоном. Green API метод CheckAccount возвращает
// chatId по phone — кешируем, чтобы не дёргать API при каждой отправке.
model MaxContact {
  id         BigInt   @id @default(autoincrement())
  idInstance BigInt
  phone      String   @db.VarChar(32)
  chatId     String   @db.VarChar(64)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([idInstance, phone])
}

// Запоминаем последний выбранный номер для каждой CRM-сущности (lead/deal/contact),
// чтобы при повторном открытии виджета подставлялся тот же телефон.
model EntityPhonePref {
  id           BigInt   @id @default(autoincrement())
  portalDomain String   @db.VarChar(190)
  entityType   String   @db.VarChar(20)
  entityId     String   @db.VarChar(40)
  phone        String   @db.VarChar(32)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@unique([portalDomain, entityType, entityId])
}

// Последний контекст Instagram-комментария на пост для конкретного клиента
// (клиентский meta-id в i2crm). Нужно для outgoing /target/feedback type=comment:
// после переключения i2crm на «официальный» способ подключения media и comment
// поля стали обязательными — i2crm больше не сопоставляет ответ по client_id сам.
// При incoming type=comment записываем upsert, при outgoing подтягиваем.
// Контекст IG-комментария для outgoing /target/feedback type=comment.
// A2: ключ составной (clientId, mediaId) — у клиента под разными постами
// разные media_id, контексты не перезаписывают друг друга. Outgoing берёт
// нужный context по mediaId, извлечённому из chat.id (i2crm_ig_<c>_c<media>).
model IgCommentContext {
  clientId  String   @db.VarChar(40)
  mediaId   String   @db.VarChar(64)
  commentId String   @db.VarChar(64)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@id([clientId, mediaId])
}

// Связь b24 message_id ↔ Instagram comment_id (Этап 3 reply на конкретный
// коммент в треде). При incoming IG-комменте мы шлём его в B24 через
// imconnector.send.messages, потом узнаём b24 message_id через
// im.dialog.messages.get (B24 не возвращает его в response send.messages)
// и сохраняем связь сюда. Когда оператор в B24 делает reply на это
// сообщение клиента — B24 в outgoing-webhook передаёт quote/parent с id
// исходного, мы по нему находим оригинальный comment_id и отвечаем именно
// на тот коммент в Instagram.
// IG Direct: связь b24 chat-message ↔ внешний IG message_id для reply
// «через цитирование» в B24 → нативный reply в Instagram Direct.
// Заполняется при incoming Direct, читается при reply из B24.
model IgDirectInboundB24Link {
  id                  BigInt   @id @default(autoincrement())
  b24ChatId           String   @db.VarChar(64)
  b24MessageId        String   @db.VarChar(64)
  clientId            String   @db.VarChar(40)
  externalMessageId   String   @db.VarChar(120)
  messageText         String?  @db.VarChar(500)
  createdAt           DateTime @default(now())

  @@unique([b24ChatId, b24MessageId])
  @@index([clientId])
  @@index([b24ChatId], map: "IgDirectInbound_b24ChatId_idx")
}

model IgInboundB24Link {
  id           BigInt   @id @default(autoincrement())
  b24ChatId    String   @db.VarChar(64)
  b24MessageId String   @db.VarChar(64)
  clientId     String   @db.VarChar(40)
  mediaId      String   @db.VarChar(64)
  commentId    String   @db.VarChar(64)
  // Сырой текст коммента клиента (без префикса «[Instagram комментарий
  // к посту…]»). Используется для матча из B24 BB-цитаты при reply.
  commentText  String?  @db.VarChar(500)
  createdAt    DateTime @default(now())

  @@unique([b24ChatId, b24MessageId])
  @@index([clientId, mediaId])
  @@index([b24ChatId], map: "IgInboundB24Link_b24ChatId_idx")
}

// Профилактика: журнал всех incoming-webhook'ов от i2crm Public API.
// Если B24 заблокирован (OVERLOAD_LIMIT и др.) — сообщения сохраняются здесь
// со status='pending'. После восстановления — endpoint /webhooks/internal/i2crm-replay
// проходит по pending и доставляет в B24. payload — полный JSON для точного
// воссоздания контекста (client_id, account_id, media_id, comment_id и т.д.).
//
// При успешной первой доставке: status='sent' + sentAt.
// При повторных попытках если они нужны: attempts инкремент.
// Очистка: cron удаляет записи старше 30 дней (если sent=success).
model I2crmEventLog {
  id        BigInt   @id @default(autoincrement())
  messageId String   @db.VarChar(64)        // i2crm message_id
  clientId  String   @db.VarChar(40)        // i2crm client_id (для индекса)
  channel   String   @db.VarChar(16)        // instdir / instcom
  incoming  Boolean                          // true=от клиента, false=outgoing-echo
  payload   String   @db.Text                // полный JSON i2crm webhook
  status    String   @default("pending") @db.VarChar(16)  // pending / sent / failed
  attempts  Int      @default(0)
  lastError String?  @db.Text
  receivedAt DateTime @default(now())
  sentAt    DateTime?

  @@unique([messageId])
  @@index([status, receivedAt])
  @@index([clientId])
}

// Снимок последнего известного состояния CRM-сущности B24 (lead/contact/deal).
// B24 шлёт ONCRM*UPDATE на ЛЮБУЮ запись в сущность — даже когда для человека
// ничего не изменилось. handleB24CrmEvent сравнивает свежий crm.<entity>.get
// с этим снимком: если значимые поля не изменились — событие в KBD-ленту не
// отправляется (убирает поток дублей «lead обновлён»); если изменились — в
// summary пишется диф «поле: было → стало».
// fields — полный crm.<entity>.get; волатильные авто-поля времени
// (DATE_MODIFY, TIMESTAMP_X, LAST_ACTIVITY_*) при сравнении игнорируются.
model B24EntitySnapshot {
  id         BigInt   @id @default(autoincrement())
  entityType String   @db.VarChar(10) // lead / contact / deal
  entityId   Int
  fields     Json     @db.Json
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([entityType, entityId])
}

// Дедуп автоответа «нерабочее время»: один автоответ на чат за одно
// нерабочее окно (ночь). chatKey: "<idInstance>:<chatId>" для Green API
// (WA/TG/MAX), "ig:<clientId>" для Instagram Direct. lastRepliedAt
// сравнивается с началом текущего нерабочего окна (см. claimOffHoursReply).
model OffHoursReply {
  id            BigInt   @id @default(autoincrement())
  chatKey       String   @unique
  lastRepliedAt DateTime
  createdAt     DateTime @default(now())
}

// Журнал сообщений Telegram-бота (@begovoy_bot) — клиентский канал,
// подключённый напрямую через Telegram Bot API (не Green API, не i2crm).
// Симметрично I2crmEventLog: каждый incoming-update и outgoing-сообщение
// журналируется здесь — это и «история» переписки, и страховка для replay,
// если B24 временно недоступен (status='pending').
// updateId уникален в пределах бота — дедуп ретраев Telegram (upsert по нему).
// outgoing-записи updateId не имеют — туда кладём синтетический "out_<ts>_<msgId>".
model TgBotEventLog {
  id         BigInt   @id @default(autoincrement())
  updateId   String   @db.VarChar(48)   // telegram update_id (in) / out_<ts>_<id> (out)
  chatId     String   @db.VarChar(40)   // telegram chat id клиента
  messageId  String?  @db.VarChar(40)   // telegram message_id
  direction  String   @db.VarChar(8)    // in / out
  payload    String   @db.Text          // полный JSON update / outgoing
  status     String   @default("pending") @db.VarChar(16)  // pending / sent / failed
  attempts   Int      @default(0)
  lastError  String?  @db.Text
  receivedAt DateTime @default(now())
  sentAt     DateTime?

  @@unique([updateId])
  @@index([status, receivedAt])
  @@index([chatId])
}
