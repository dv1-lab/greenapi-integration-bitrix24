DATABASE_URL="mysql://root:root@localhost:3306/adapter"
BITRIX24_CLIENT_ID="YOUR_CLIENT_ID"
BITRIX24_CLIENT_SECRET="YOUR_CLIENT_SECRET"
APP_URL=https://your-adapter-domain.com

# Защита от перегрузки B24 (circuit-breaker + кран). См. b24-circuit-breaker.ts.
# Кран min-interval применяется ТОЛЬКО к фоновому appKind=customer360 (вал
# crm.deal.get), интерактивный social (сообщения клиентам) не тормозится.
B24_MIN_INTERVAL_MS=1000
B24_OVERLOAD_COOLDOWN_BASE_MS=30000
B24_OVERLOAD_COOLDOWN_MAX_MS=300000

# Канал админ-алертов B24HealthCheckService (@agent_dv_bot).
# Если не задано — алерты идут только в WARN-лог.
ALERT_BOT_TOKEN=
ALERT_CHAT_ID=

# omnisocial surface (B24-поверхность поверх нашего ядра вместо green-api.com)
OMNI_SURFACE_INSTANCES=
OMNI_SURFACE_URL=
